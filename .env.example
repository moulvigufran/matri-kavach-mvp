# Copy these into Render > Environment. Never commit real values.
DATABASE_URL=            # Render Postgres "Internal Database URL"
PUBLIC_BASE_URL=         # optional, Render fills RENDER_EXTERNAL_URL for you
LIVE_KEY=                # a long secret you choose; opens the real-phone session at /?key=<LIVE_KEY>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=    # optional, defaults to the sandbox number +14155238886
TWILIO_SMS_FROM=         # your Twilio trial number (used for the IVR call, and SMS if enabled)
TEST_PHONE=              # one phone that plays nurse, hospitals, doctor and family (country code, like +919876543210)
# Or set separate phones below. DH and SDH may be the same phone.
PHONE_NURSE=
PHONE_DH=
PHONE_SDH=
PHONE_CHC=
PHONE_MC=
PHONE_DOCTOR=
PHONE_FAMILY=
PHONE_BLOODBANK=
PHONE_DISTRICT=
PHONE_ASHA=
# Optional
# CHANNEL=whatsapp       # or sms
# SMS_ALSO=1             # also text the family number
# REPLY_WINDOW_SEC=120   # lower for testing
# IVR_WAIT_SEC=60
# Free test channel instead of WhatsApp: set this and texts go by Telegram (make a bot with @BotFather).
# TELEGRAM_BOT_TOKEN=
# WhatsApp through Meta's own Cloud API (free test number). When set, texts go this way.
# WA_TOKEN=               # access token from Meta app > WhatsApp > API Setup (or a System User token)
# WA_PHONE_NUMBER_ID=     # "Phone number ID" on the same page (not the phone number itself)
# WA_APP_SECRET=          # optional: checks Meta's webhook signature
# WA_GRAPH_VERSION=v26.0
