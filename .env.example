# Copy these into Render > Environment. Never commit real values.
DATABASE_URL=            # Render Postgres "Internal Database URL"
PUBLIC_BASE_URL=         # your Render address, e.g. https://matri-kavach.onrender.com (no trailing slash)
LIVE_KEY=                # a long secret you choose; opens the real-phone session at /?key=<LIVE_KEY>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=    # WhatsApp sandbox number, e.g. +14155238886
TWILIO_SMS_FROM=         # your Twilio trial number (used for the IVR call, and SMS if enabled)
# Test phones, with country code. DH and SDH may be the same phone for the team test.
PHONE_NURSE=
PHONE_DH=
PHONE_SDH=
PHONE_CHC=
PHONE_MC=
PHONE_DOCTOR=
PHONE_FAMILY=
PHONE_BLOODBANK=
PHONE_DISTRICT=
PHONE_ASHA=
# Optional
# CHANNEL=whatsapp       # or sms
# SMS_ALSO=1             # also text the family number
# REPLY_WINDOW_SEC=120   # lower for testing
# IVR_WAIT_SEC=60
